# ── gonk server pack ────────────────────────────────────────────────
# This repo tracks the PACK: configs, scripts, and the mod manifest.
# It deliberately does not track worlds, caches, logs, or third-party
# mod jars. See README.md for how to assemble a playable instance.

# ── Worlds and per-world data (3.4 GB) ──
/minecraft/saves/
/minecraft/Distant_Horizons_server_data/
/minecraft/server-resource-packs/

# ── Generated caches and build noise ──
/minecraft/.mixin.out/
/minecraft/.probe/
/minecraft/.sable/
/minecraft/.vscode/
/minecraft/dynamic-data-pack-cache/
/minecraft/dynamic-resource-pack-cache/
/minecraft/downloads/
/minecraft/coremods/
/minecraft/texturepacks/

# ── Logs, crashes, debug dumps ──
/minecraft/logs/
/minecraft/crash-reports/
/minecraft/debug/
/minecraft/screenshots/
/minecraft/bluemap/logs/

# ── Per-world / per-server state (the JEI path embeds the server IP) ──
/minecraft/config/jei/world/
/minecraft/bluemap/pluginState.json

# ── Per-player state, not pack content ──
/minecraft/xaero/
/minecraft/XaeroWaypoints_BACKUP240807/
/minecraft/usercache.json
/minecraft/usernamecache.json
/minecraft/patchouli_data.json
/minecraft/patchouli_books/
/minecraft/ponders_watched.json
/minecraft/command_history.txt

# ── Contains the live server address ──
/minecraft/servers.dat
/minecraft/servers.dat_old

# ── Contains a generated auth token ──
/minecraft/kubejs/config/web_server.json

# ── Mod jars: track the packwiz index, not the downloads ──
# mods/.index/*.pw.toml carries the URL + sha512 for every mod that
# Prism installed, so the third-party jars are reproducible without
# being redistributed here. The exceptions below were added by hand and
# have no index entry, so they must be tracked or the pack won't build.
#
# These are version globs on purpose. They used to be exact filenames,
# which meant shipping thee-1.0.1.jar would silently drop the pack's
# own settlements mod from the repo. Match the name, not the version.
/minecraft/mods/*
!/minecraft/mods/.index/

# custom, unreproducible — losing these loses the pack
!/minecraft/mods/thee-*.jar
!/minecraft/mods/chaosgate-*.jar
!/minecraft/mods/omnifix-*.jar
!/minecraft/mods/akschematics-*.jar

# third-party, hand-installed (no packwiz index entry)
!/minecraft/mods/kubejs-neoforge-*.jar
!/minecraft/mods/kubejs-create-neoforge-*.jar
!/minecraft/mods/lootjs-neoforge-*.jar
!/minecraft/mods/morejs-neoforge-*.jar
